# Spring Config Contract 대표 배포 입력 (configContractCheck 전용)
# 키 존재만 표현한다. 실제 값이나 secret을 절대 넣지 않는다.
# 실제 배포는 CD가 Secret으로 생성하는 application-{stage,prod}.yml을 사용하며, 이 파일은 런타임에 읽히지 않는다.
# logback-spring.xml의 CW_* 키는 도구가 발견하지 못해 UNUSED로 판정되므로 넣지 않는다.

# 인증
JWT_SECRET=

# Discord
DISCORD_WEBHOOK_URL=

# SmartThings
SMARTTHINGS_API_URL=
SMARTTHINGS_OAUTH_URL=
SMARTTHINGS_AUTHORIZE_URL=
SMARTTHINGS_REDIRECT_URI=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_TUB_CLEAN_ENABLED=
SMARTTHINGS_TUB_CLEAN_CRON=
SMARTTHINGS_TUB_CLEAN_CYCLE=
SMARTTHINGS_WEBHOOK_ENABLED=
SMARTTHINGS_WEBHOOK_APP_ID=
SMARTTHINGS_WEBHOOK_KEY_URL=
SMARTTHINGS_WEBHOOK_EVENT_RETENTION_DAYS=

# DataGSM
THIRD_PARTY_DATAGSM_CLIENT_ID=
THIRD_PARTY_DATAGSM_CLIENT_SECRET=
THIRD_PARTY_DATAGSM_REDIRECT_URI=
THIRD_PARTY_DATAGSM_EVENT_SECRET=
THIRD_PARTY_DATAGSM_EVENT_IDEMPOTENCY_TTL_DAYS=

# FCM
THIRD_PARTY_FCM_SERVICE_ACCOUNT_JSON=
